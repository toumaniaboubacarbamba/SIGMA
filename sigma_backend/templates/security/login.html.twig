{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center -mt-8">
    <div class="bg-white border border-gray-200 rounded-2xl p-8 w-full max-w-md">

        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-green-700">SIGMA</h1>
            <p class="text-gray-500 text-sm mt-1">Espace administration</p>
        </div>

        {% if error %}
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="space-y-4">
            <div>
                <label class="block text-sm text-gray-600 mb-1">Email</label>
                <input type="email"
                       name="_username"
                       value="{{ last_username }}"
                       autocomplete="email"
                       required
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-green-500">
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Mot de passe</label>
                <input type="password"
                       name="_password"
                       autocomplete="current-password"
                       required
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-green-500">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit"
                    class="w-full bg-green-700 text-white py-2.5 rounded-lg hover:bg-green-800 text-sm font-medium mt-2">
                Se connecter
            </button>
        </form>

    </div>
</div>
{% endblock %}
