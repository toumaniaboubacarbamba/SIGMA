{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-800">Gestion des utilisateurs</h1>
        <p class="text-sm text-gray-500 mt-1">Créez, activez ou désactivez les comptes agents et directeurs</p>
    </div>
    <a href="{{ path('admin_users_new') }}"
       class="bg-green-700 hover:bg-green-800 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
        + Nouvel utilisateur
    </a>
</div>

{% for message in app.flashes('success') %}
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4">{{ message }}</div>
{% endfor %}

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-4 py-3 text-gray-600 font-semibold">Nom complet</th>
                <th class="text-left px-4 py-3 text-gray-600 font-semibold">Email</th>
                <th class="text-left px-4 py-3 text-gray-600 font-semibold">Rôle</th>
                <th class="text-left px-4 py-3 text-gray-600 font-semibold">Statut</th>
                <th class="text-left px-4 py-3 text-gray-600 font-semibold">Créé par</th>
                <th class="text-left px-4 py-3 text-gray-600 font-semibold">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {% for user in users %}
            <tr class="hover:bg-gray-50 transition">
                <td class="px-4 py-3 font-medium text-gray-800">{{ user.nomComplet }}</td>
                <td class="px-4 py-3 text-gray-600">{{ user.email }}</td>
                <td class="px-4 py-3">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="bg-purple-100 text-purple-700 text-xs font-semibold px-2 py-1 rounded-full">Admin</span>
                    {% elseif 'ROLE_DIRECTEUR' in user.roles %}
                        <span class="bg-blue-100 text-blue-700 text-xs font-semibold px-2 py-1 rounded-full">Directeur</span>
                    {% else %}
                        <span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-1 rounded-full">Agent</span>
                    {% endif %}
                </td>
                <td class="px-4 py-3">
                    {% if user.isActive %}
                        <span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-1 rounded-full">● Actif</span>
                    {% else %}
                        <span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-1 rounded-full">● Désactivé</span>
                    {% endif %}
                </td>
                <td class="px-4 py-3 text-gray-500">{{ user.createdBy ? user.createdBy.nomComplet : '—' }}</td>
                <td class="px-4 py-3">
                    <div class="flex items-center gap-2">
                        {# Toggle status #}
                        <form method="POST" action="{{ path('admin_users_toggle_status', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                            <button class="text-xs px-3 py-1 rounded-lg font-medium transition
                                {{ user.isActive
                                    ? 'bg-orange-100 text-orange-700 hover:bg-orange-200'
                                    : 'bg-green-100 text-green-700 hover:bg-green-200' }}">
                                {{ user.isActive ? 'Désactiver' : 'Activer' }}
                            </button>
                        </form>

                        {# Changer le rôle #}
                        <form method="POST" action="{{ path('admin_users_change_role', {id: user.id}) }}" class="flex items-center gap-1">
                            <select name="role" class="text-xs border border-gray-200 rounded-lg px-2 py-1 text-gray-700 focus:outline-none focus:ring-2 focus:ring-green-300">
                                <option value="ROLE_AGENT" {{ 'ROLE_AGENT' in user.roles ? 'selected' }}>Agent</option>
                                <option value="ROLE_DIRECTEUR" {{ 'ROLE_DIRECTEUR' in user.roles ? 'selected' }}>Directeur</option>
                                <option value="ROLE_ADMIN" {{ 'ROLE_ADMIN' in user.roles ? 'selected' }}>Admin</option>
                            </select>
                            <button class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-1 rounded-lg transition">OK</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-gray-400">Aucun utilisateur trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
