{% extends "base.html.twig" %}

{% block title %}Tableau de bord Directeur{% endblock %}

{% block body %}
    <div class="mb-8">
        <h1 class="text-2xl font-medium text-gray-800">Bonjour, {{ app.user.nomComplet }}</h1>
        <p class="text-gray-500 mt-1">Tableau de bord Direction — {{ "now"|date("d/m/Y") }}</p>
    </div>

    {# KPIs #}
    <div class="grid grid-cols-2 gap-6 mb-8">
        <div class="bg-white border border-gray-200 rounded-xl p-6">
            <p class="text-sm text-gray-500 mb-1">DMT (jours)</p>
            <p class="text-3xl font-medium text-blue-600">{{ dmt }}</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-6">
            <p class="text-sm text-gray-500 mb-1">Taux d'approbation</p>
            <p class="text-3xl font-medium text-green-600">{{ taux_approbation }}%</p>
        </div>
    </div>

    {# Volume #}
    <div class="grid grid-cols-3 gap-6 mb-8">
        <div class="bg-white border border-gray-200 rounded-xl p-6">
            <p class="text-sm text-gray-500 mb-1">En attente de signature</p>
            <p class="text-3xl font-medium text-orange-500">{{ en_attente }}</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-6">
            <p class="text-sm text-gray-500 mb-1">Approuvés</p>
            <p class="text-3xl font-medium text-green-600">{{ approuves }}</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-6">
            <p class="text-sm text-gray-500 mb-1">Rejetés</p>
            <p class="text-3xl font-medium text-red-500">{{ rejetes }}</p>
        </div>
    </div>

    <a href="{{ path('directeur_dossiers') }}"
       class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
        Voir les dossiers en attente
    </a>
{% endblock %}
