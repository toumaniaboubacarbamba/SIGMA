{% extends 'base.html.twig' %}

{% block title %}Dossiers en attente de signature{% endblock %}

{% block body %}
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-medium text-gray-800">Dossiers en attente de signature</h1>
    <span class="text-sm text-gray-500">{{ dossiers|length }} dossier(s)</span>
</div>

<div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
                <th class="text-left px-6 py-3 text-gray-600 font-medium">Référence</th>
                <th class="text-left px-6 py-3 text-gray-600 font-medium">Citoyen</th>
                <th class="text-left px-6 py-3 text-gray-600 font-medium">Date dépôt</th>
                <th class="text-left px-6 py-3 text-gray-600 font-medium">Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {% for dossier in dossiers %}
            <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-blue-600">{{ dossier.numeroReference }}</td>
                <td class="px-6 py-4 text-gray-700">{{ dossier.proprietaire.nomComplet }}</td>
                <td class="px-6 py-4 text-gray-500">{{ dossier.dateDepot|date('d/m/Y H:i') }}</td>
                <td class="px-6 py-4">
                    <a href="{{ path('directeur_dossier_detail', {id: dossier.id}) }}"
                       class="text-blue-600 hover:underline text-sm">
                        Examiner →
                    </a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-400">
                    Aucun dossier en attente de signature
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
