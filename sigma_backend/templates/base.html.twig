<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SIGMA{% endblock %} — Système Intégré de Gestion Administrative</title>
        <script src="https://cdn.tailwindcss.com"></script>
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-gray-50 min-h-screen">

        {% if app.user %}
        <nav class="bg-white border-b border-gray-200 px-6 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <span class="text-green-700 font-bold text-xl">SIGMA</span>
                <span class="text-gray-400 text-sm">Suivi administratif</span>
            </div>
            <div class="flex items-center gap-6">
                <a href="/dashboard" class="text-gray-600 hover:text-green-700 text-sm">Tableau de bord</a>
                <a href="/dossiers" class="text-gray-600 hover:text-green-700 text-sm">Dossiers</a>
                <span class="text-gray-400 text-sm">{{ app.user.nomComplet }}</span>
                <a href="{{ path('app_logout') }}" class="text-red-500 hover:text-red-700 text-sm">Déconnexion</a>
            </div>
        </nav>
        {% endif %}

        <main class="max-w-6xl mx-auto px-6 py-8">
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4">
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4">
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}{% endblock %}
    </body>
</html>
