# --------------------------------------------------------------------------- #
# Configuration du microservice IA de SIGMA
# --------------------------------------------------------------------------- #
# La clé Mistral est lue EN PRIORITÉ depuis le .env à la racine du projet
# (../.env). Ce fichier .env local (optionnel) sert uniquement à surcharger
# la config pour le service, par ex. pour pointer un autre modèle en dev.
#
# Copie-le en .env si tu veux surcharger quelque chose :  cp .env.example .env

# Clé API Mistral (déjà présente dans le .env racine — ne la duplique pas ici
# en prod). Décommente seulement pour un override local.
# MISTRAL_API_KEY=ta_cle_ici

# Modèle Mistral utilisé pour la classification (défaut : mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# Endpoint de l'API Mistral (défaut : officiel)
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Timeout réseau en secondes pour l'appel à Mistral (défaut : 30)
# MISTRAL_TIMEOUT=30
